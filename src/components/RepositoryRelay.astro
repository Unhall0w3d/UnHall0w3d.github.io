---
import privateDates from "../config/private-relay-dates.json";

type RepositorySpec = {
  name: string;
  displayName: string;
  classification: string;
  description: string;
  language: string;
  branch: string;
  head: string;
  pushedAt: string;
  visibility?: "PUBLIC" | "PRIVATE" | "UNAVAILABLE";
};

type GitHubRepository = {
  description?: string | null;
  private: boolean;
  default_branch?: string;
  language?: string | null;
  pushed_at?: string;
};

type GitHubCommit = {
  sha?: string;
};

const owner = "Unhall0w3d";
const repositorySpecs: RepositorySpec[] = [
  {
    name: "aletheiauc",
    displayName: "AletheiaUC",
    classification: "ASSESSMENT ENGINE",
    description: "Cisco Collaboration health assessment, diagnostics, and reporting.",
    language: "Python",
    branch: "main",
    head: "<REDACTED>",
    pushedAt: privateDates.aletheiauc,
    visibility: "PRIVATE",
  },
  {
    name: "soul-slash",
    displayName: "Soul/",
    classification: "LOCAL INTELLIGENCE",
    description: "Local-first assistant with deterministic skills, safety gates, and human-approved memory.",
    language: "Ruby",
    branch: "main",
    head: "<REDACTED>",
    visibility: "PRIVATE",
    pushedAt: privateDates["soul-slash"],
  },
  {
    name: "mind-enigma",
    displayName: "Mind Enigma",
    classification: "CISCO AUTOMATION",
    description: "Cisco Collaboration scripts and operational automation.",
    language: "Python",
    branch: "master",
    head: "f37fcfe2",
    pushedAt: "2026-07-28",
  },
  {
    name: "ruckus-backup-retriever",
    displayName: "Ruckus Backup Retriever",
    classification: "NETWORK UTILITY",
    description: "PowerShell backup downloader for RUCKUS SmartZone environments.",
    language: "PowerShell",
    branch: "main",
    head: "dee4dcdf",
    pushedAt: "2026-07-28",
  },
  {
    name: "unreal-codex-playtesting-pipeline",
    displayName: "Unreal Codex Playtesting",
    classification: "RUNTIME TESTING",
    description: "Sanitized reference templates for a bounded Unreal Engine runtime playtesting loop with Codex.",
    language: "Python",
    branch: "main",
    head: "9c028216",
    pushedAt: "2026-08-25",
  },
];

async function refreshRepository(spec: RepositorySpec): Promise<RepositorySpec> {
  if (spec.visibility === "PRIVATE") return spec;

  try {
    const repositoryResponse = await fetch(`https://api.github.com/repos/${owner}/${spec.name}`, {
      headers: { Accept: "application/vnd.github+json" },
    });
    if (!repositoryResponse.ok) return { ...spec, visibility: "UNAVAILABLE" };

    const repository = (await repositoryResponse.json()) as GitHubRepository;
    const pushedAt = repository.pushed_at || spec.pushedAt;
    if (repository.private !== false) {
      return { ...spec, pushedAt, visibility: repository.private ? "PRIVATE" : "UNAVAILABLE" };
    }
    const branch = repository.default_branch || spec.branch;
    const result: RepositorySpec = {
      ...spec, branch, pushedAt, visibility: "PUBLIC",
      description: repository.description || spec.description,
      language: repository.language || spec.language,
      head: "UNAVAILABLE",
    };
    try {
      const response = await fetch(
        `https://api.github.com/repos/${owner}/${spec.name}/commits/${encodeURIComponent(branch)}`,
        { headers: { Accept: "application/vnd.github+json" } },
      );
      if (response.ok) {
        const commit = (await response.json()) as GitHubCommit;
        result.head = commit.sha?.slice(0, 8) || result.head;
      }
    } catch { /* Repository visibility and push date remain verified. */ }
    return result;
  } catch {
    return { ...spec, visibility: "UNAVAILABLE" };
  }
}

const repositories = await Promise.all(repositorySpecs.map(refreshRepository));
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  day: "2-digit",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
---

<section class="repository-relay" aria-labelledby="repository-relay-title">
  <header class="repository-relay-header">
    <div>
      <p class="eyebrow">PUBLIC CODEX // SELECTED WORKS</p>
      <h2 id="repository-relay-title">Repository relay</h2>
    </div>
    <div class="repository-relay-state" aria-label={`${repositories.length} selected repositories`}>
      <span class="repository-relay-pulse" aria-hidden="true"></span>
      GH-{String(repositories.length).padStart(2, "0")} // INDEXED
    </div>
  </header>

  <div class="repository-grid">
    {repositories.map((repository, index) => {
      const linked = repository.visibility === "PUBLIC";
      const Card = linked ? "a" : "div";
      return (
      <article class="repository-node">
        <Card href={linked ? `https://github.com/${owner}/${repository.name}` : undefined} aria-label={linked ? `Open ${repository.displayName} on GitHub` : undefined}>
          <div class="repository-node-header">
            <span>NODE {String(index + 1).padStart(2, "0")}</span>
            <span>{repository.classification}</span>
          </div>
          <div class="repository-node-copy">
            <h3>{repository.displayName}</h3>
            <p>{repository.description}</p>
          </div>
          <dl class="repository-node-stats">
            <div><dt>BRANCH</dt><dd>{repository.branch}</dd></div>
            <div><dt>HEAD</dt><dd><code>{linked ? repository.head : "<REDACTED>"}</code></dd></div>
            <div><dt>STACK</dt><dd>{repository.language}</dd></div>
            <div><dt>SYNC</dt><dd>{dateFormatter.format(new Date(repository.pushedAt)).toUpperCase()}</dd></div>
          </dl>
          <div class="repository-node-footer">
            <span>STATUS // {repository.visibility}</span>
            <strong>{linked ? "OPEN REPOSITORY ↗" : repository.visibility === "PRIVATE" ? "ACCESS DENIED" : "ACCESS UNAVAILABLE"}</strong>
          </div>
        </Card>
      </article>
      );
    })}
  </div>

  <footer class="repository-relay-footer">
    <span>HEAD IDENTIFIERS // 8-CHAR SHORT SHA OR REDACTED</span>
    <a href={`https://github.com/${owner}`}>ALL PUBLIC NODES ↗</a>
  </footer>
</section>
