---
import { pillarTitle, tagLabel } from "../config/taxonomy";
import type { Post } from "../lib/posts";
import { formatPostDate, postExcerpt, postUrl, readingTime } from "../lib/posts";

interface Props {
  posts: Post[];
  numbered?: boolean;
}

const { posts, numbered = false } = Astro.props;
---

<div class="signal-list post-list">
  {posts.map((post, index) => {
    const pillar = pillarTitle(post.data.pillar);
    const tagSearch = post.data.tags.map((t) => `${t} ${tagLabel(t)}`).join(" ");
    return (
      <article
        class="transmission-card"
        data-pillar={post.data.pillar}
        data-has-tool={post.data.hasTool ? "1" : "0"}
        data-year={String(post.data.pubDate.getFullYear())}
        data-search-item={`${post.data.title} ${pillar} ${post.data.pillar} ${tagSearch} ${post.data.description}`.toLowerCase()}
      >
        <div class="card-index">{numbered ? String(index + 1).padStart(2, "0") : "//"}</div>
        <div class="card-body">
          <p class="card-type">{pillar}</p>
          <h3><a href={postUrl(post)}>{post.data.title}</a></h3>
          <p>{postExcerpt(post)}</p>
        </div>
        <div class="card-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
          <span>{readingTime(post)} min read</span>
        </div>
      </article>
    );
  })}
</div>
