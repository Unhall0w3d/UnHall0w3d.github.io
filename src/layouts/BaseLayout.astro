---
import "@fontsource/inter/400.css";
import "@fontsource/inter/400-italic.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";
import { ClientRouter } from "astro:transitions";
import AmbientPlayer from "../components/AmbientPlayer.astro";
import CommandPalette from "../components/CommandPalette.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../config/site";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/editorial.css";

interface Props {
  downloadPage?: boolean;
  pagefindBody?: boolean;
  mainClass?: string;
  title?: string;
  description?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  robots?: string;
}

const {
  downloadPage = false,
  pagefindBody = false,
  mainClass,
  title = site.title,
  description = site.description,
  type = "website",
  publishedTime,
  modifiedTime,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  robots
} = Astro.props;

const canonicalPath = Astro.url.pathname.replace(/index\.html$/, "") || "/";
const canonical = new URL(canonicalPath, site.url);
const documentTitle = title === site.title ? title : `${title} | ${site.name}`;

const defaultOgPath = (() => {
  if (canonicalPath === "/") return "/og/index.png";
  const topMatch = canonicalPath.match(/^\/(posts|tools|experiments|about)\.html$/);
  if (topMatch) return `/og/${topMatch[1]}.png`;
  const postMatch = canonicalPath.match(/^\/(\d{4}\/\d{2}\/\d{2}\/[^/]+)\.html$/);
  if (postMatch) return `/og/${postMatch[1]}.png`;
  return "/og/index.png";
})();

const socialImage = new URL(image ?? defaultOgPath, site.url);
const socialImageAlt = imageAlt ?? `${documentTitle} — social preview card`;
const socialImageWidth = image ? imageWidth : 1200;
const socialImageHeight = image ? imageHeight : 630;
const socialImageType = (() => {
  const pathname = socialImage?.pathname.toLowerCase();
  if (!pathname) return undefined;
  if (pathname.endsWith(".jpg") || pathname.endsWith(".jpeg")) return "image/jpeg";
  if (pathname.endsWith(".webp")) return "image/webp";
  if (pathname.endsWith(".gif")) return "image/gif";
  if (pathname.endsWith(".png")) return "image/png";
  return undefined;
})();
---

<!doctype html>
<html lang="en-US" data-theme="aftertone">
  <head>
    <meta charset="utf-8" />
    {downloadPage && <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.youtube.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://i.ytimg.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'none'; form-action 'none'" />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0E1013" />
    <link rel="stylesheet" href="/assets/site-header.css" />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" sizes="any" data-site-icon />
    <script is:inline src="/assets/site-theme.js"></script>
    <ClientRouter />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="google-site-verification" content={site.verification.google} />
    <meta name="msvalidate.01" content={site.verification.bing} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS feed`} href="/feed.xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest?v=3" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    {socialImageType && <meta property="og:image:type" content={socialImageType} />}
    {socialImageWidth && <meta property="og:image:width" content={String(socialImageWidth)} />}
    {socialImageHeight && <meta property="og:image:height" content={String(socialImageHeight)} />}
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <title>{documentTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="ambient-grid" aria-hidden="true"></div>
    <SiteHeader />

    <main id="main-content" class={mainClass} tabindex="-1" data-pagefind-body={pagefindBody ? "" : undefined}>
      <slot />
    </main>

    <CommandPalette />
    <AmbientPlayer />
    <SiteFooter />
    <script is:inline type="module" src="/assets/command-palette.js"></script>
  </body>
</html>
