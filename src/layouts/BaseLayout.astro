---
import header from "../components/site-header.html?raw";
import { site } from "../config/site";
import "../styles/global.css";
import "../styles/editorial.css";

interface Props {
  downloadPage?: boolean;
  mainClass?: string;
  title?: string;
  description?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  robots?: string;
}

const {
  downloadPage = false,
  mainClass,
  title = site.title,
  description = site.description,
  type = "website",
  publishedTime,
  modifiedTime,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  robots
} = Astro.props;

const canonicalPath = Astro.url.pathname.replace(/index\.html$/, "") || "/";
const canonical = new URL(canonicalPath, site.url);
const documentTitle = title === site.title ? title : `${title} | ${site.name}`;
const socialImage = new URL(image ?? site.socialImage.path, site.url);
const socialImageAlt = imageAlt ?? site.socialImage.alt;
const socialImageWidth = image ? imageWidth : site.socialImage.width;
const socialImageHeight = image ? imageHeight : site.socialImage.height;
const socialImageType = (() => {
  const pathname = socialImage?.pathname.toLowerCase();
  if (!pathname) return undefined;
  if (pathname.endsWith(".jpg") || pathname.endsWith(".jpeg")) return "image/jpeg";
  if (pathname.endsWith(".webp")) return "image/webp";
  if (pathname.endsWith(".gif")) return "image/gif";
  if (pathname.endsWith(".png")) return "image/png";
  return undefined;
})();
---

<!doctype html>
<html lang="en-US" data-theme="aftertone-dark">
  <head>
    <meta charset="utf-8" />
    {downloadPage && <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'" />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2b2c2e" />
    <link rel="stylesheet" href="/assets/site-header.css" />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" sizes="any" data-site-icon />
    <script is:inline src="/assets/site-theme.js"></script>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="google-site-verification" content={site.verification.google} />
    <meta name="msvalidate.01" content={site.verification.bing} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS feed`} href="/feed.xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest?v=3" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    {socialImageType && <meta property="og:image:type" content={socialImageType} />}
    {socialImageWidth && <meta property="og:image:width" content={String(socialImageWidth)} />}
    {socialImageHeight && <meta property="og:image:height" content={String(socialImageHeight)} />}
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <title>{documentTitle}</title>
    {!downloadPage && <>
      <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.integrations.adsensePublisher}`} crossorigin="anonymous"></script>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.integrations.googleAnalytics}`}></script>
      <script is:inline define:vars={{ measurementId: site.integrations.googleAnalytics }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', measurementId);
      </script>
    </>}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="ambient-grid" aria-hidden="true"></div>
    <Fragment set:html={header} />

    <main id="main-content" class={mainClass} tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        <span class="status-light" aria-hidden="true"></span>
        Signal maintained by {site.author.name}
      </p>
      <p class="footer-code">NOCTHOUGHTS // SYRACUSE, NY // {new Date().getFullYear()}</p>
      <nav class="footer-links" aria-label="Footer links">
        <a href="/feed.xml">RSS</a>
        <a href="/privacypolicy.html">Privacy</a>
        <a href={site.social.github}>GitHub</a>
      </nav>
    </footer>
  </body>
</html>
