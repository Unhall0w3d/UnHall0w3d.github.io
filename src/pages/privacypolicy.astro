---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/reference-pages.css";

const page = await getEntry("pages", "privacy-policy");
if (!page) throw new Error("Privacy policy content is missing");
const { Content, headings } = await render(page);
const description = page.data.description;
---

<BaseLayout title={page.data.title} description={description}>
  <div class="reference-page">
    <header class="page-hero">
      <p class="eyebrow">Site policy</p>
      <h1>{page.data.title}</h1>
      <p class="page-deck">{description}</p>
    </header>
    <div class="reference-grid policy">
      <nav aria-labelledby="policy-contents">
        <h2 id="policy-contents">On this page</h2>
        <ul>{headings.filter(({ depth }) => depth === 2).map(({ slug, text }) => (
          <li><a href={`#${slug}`}>{text}</a></li>
        ))}</ul>
      </nav>
      <div class="prose"><Content /></div>
    </div>
  </div>
</BaseLayout>
