---
import BaseLayout from "../layouts/BaseLayout.astro";
import OperatorLinks from "../components/OperatorLinks.astro";
import PostList from "../components/PostList.astro";
import MusicPlayer from "../components/MusicPlayer.astro";
import RepositoryRelay from "../components/RepositoryRelay.astro";
import { site } from "../config/site";
import { getCollection } from "astro:content";
import { sortPosts, type Post } from "../lib/posts";

const allPosts = sortPosts((await getCollection("posts", ({ data }) => !data.draft)) as Post[]);
const latestPosts = allPosts.slice(0, 5);
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  alternateName: ["The NOC Thoughts Blog", "nocthoughts.com"],
  url: `${site.url}/`
};
---

<BaseLayout>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span>TRANSMISSION ACTIVE</span> INFRASTRUCTURE FIELD LOG</p>
      <h1>Where network operations meet <em>techno-sorcery.</em></h1>
      <p class="hero-deck">
        {site.tagline}. Hard-won fixes, useful scripts, and the operational
        knowledge that usually appears only after something catches fire.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/tools.html">Find a tool</a>
        <a class="button button-ghost" href="/posts.html">Read the field notes</a>
      </div>
    </div>

    <aside class="signal-card" aria-label="Site signal status">
      <div class="signal-card-header">
        <span>SYSTEM SIGNAL</span>
        <span>01-A</span>
      </div>
      <button class="signal-flip" type="button" aria-pressed="false" aria-label="Kenneth Perry. Show Soul's Chippy avatar">
        <span class="signal-flip-inner">
          <span class="signal-face signal-face-portrait" aria-hidden="true">
            <img src={site.author.avatar} width="2048" height="2048" alt="" />
            <span class="signal-face-label">OPERATOR // 01</span>
            <span class="signal-flip-prompt">TAP TO DECRYPT ↻</span>
          </span>
          <span class="signal-face signal-face-soul" aria-hidden="true">
            <chippy-pet state="idle" paused hide-label></chippy-pet>
            <span class="signal-face-label">SOUL // CHIPPY</span>
            <span class="signal-flip-prompt">RETURN TO OPERATOR ↻</span>
          </span>
        </span>
      </button>
      <dl class="signal-stats">
        <div><dt>FOCUS</dt><dd>UC / AUTOMATION</dd></div>
        <div><dt>ARCHIVE</dt><dd>{allPosts.length} ENTRIES</dd></div>
        <div><dt>STATE</dt><dd class="online">ONLINE</dd></div>
      </dl>
    </aside>
  </section>

  <section class="tool-start" aria-labelledby="tool-start-title">
    <header class="section-header">
      <div><p class="eyebrow">THE FIELD TOOLBOX</p><h2 id="tool-start-title">What are you working on?</h2></div>
      <a class="text-link" href="/tools.html">All tools &amp; downloads →</a>
    </header>
    <div class="tool-start-grid">
      <a href="/tools.html#phone-changes"><strong>Update CUCM phones</strong><span>CSV-driven BLF labels and primary-line auto answer.</span></a>
      <a href="/tools.html#audits"><strong>Audit a UC deployment</strong><span>Read-only SQL for extensions, speed dials, and calling access.</span></a>
      <a href="/tools.html#operations"><strong>Handle operational tasks</strong><span>SmartZone backup retrieval and an analog call guard.</span></a>
    </div>
  </section>

  <section class="transmissions" aria-labelledby="transmissions-title">
    <header class="section-header">
      <div>
        <p class="eyebrow">LATEST SIGNALS</p>
        <h2 id="transmissions-title">Recent transmissions</h2>
      </div>
      <a class="text-link" href="/posts.html">View complete archive <span>→</span></a>
    </header>

    <PostList posts={latestPosts} numbered />
  </section>

  <div class="signal-utility-row">
    <OperatorLinks />

    <MusicPlayer />
  </div>

  <RepositoryRelay />
</BaseLayout>

<script is:inline type="module" src="/assets/chippy/chippy.mjs"></script>

<script>
  document.querySelectorAll<HTMLButtonElement>(".signal-flip").forEach((control) => {
    const showFace = (showSoul: boolean, musicActive = false) => {
      control.setAttribute("aria-pressed", String(showSoul));
      control.toggleAttribute("aria-disabled", musicActive);
      control.querySelector("chippy-pet")?.toggleAttribute("paused", !showSoul);
      control.setAttribute(
        "aria-label",
        musicActive
          ? "Soul's Chippy avatar. Music is playing."
          : showSoul
            ? "Soul's Chippy avatar. Show Kenneth Perry"
            : "Kenneth Perry. Show Soul's Chippy avatar"
      );
    };

    control.addEventListener("click", () => {
      if (control.hasAttribute("aria-disabled")) return;
      const flipped = control.getAttribute("aria-pressed") !== "true";
      showFace(flipped);
    });

    window.addEventListener("noc:ambient-playback", ((event: CustomEvent<{ playing: boolean }>) => {
      showFace(event.detail.playing, event.detail.playing);
    }) as EventListener);
  });
</script>
