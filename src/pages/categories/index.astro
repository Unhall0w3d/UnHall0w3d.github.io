---
import { getCollection } from "astro:content";
import { PILLAR_META } from "../../config/taxonomy";
import PageLayout from "../../layouts/PageLayout.astro";
import { getPillars, type Post } from "../../lib/posts";

const posts = (await getCollection("posts", ({ data }) => !data.draft)) as Post[];
const pillars = getPillars(posts);
---

<PageLayout
  title="Operational pillars"
  description="Field notes organized across five core engineering domains."
  eyebrow="SIGNAL CLASSIFICATION // 5 PILLARS"
>
  <div class="term-grid">
    {pillars.map(({ slug, title, posts: entries }) => (
      <a href={`/categories/${slug}.html`}>
        <span>{String(entries.length).padStart(2, "0")} signals</span>
        <strong>{title}</strong>
        <small>{PILLAR_META[slug].description}</small>
      </a>
    ))}
  </div>
</PageLayout>
