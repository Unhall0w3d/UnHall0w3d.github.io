---
import { getCollection } from "astro:content";
import PostList from "../../components/PostList.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import { getTerms, sortPosts, termSlug, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = (await getCollection("posts", ({ data }) => !data.draft)) as Post[];
  return getTerms(posts, "tags").map(([tag, entries]) => ({
    params: { tag: termSlug(tag) },
    props: { tag, posts: sortPosts(entries) }
  }));
}

interface Props { tag: string; posts: Post[]; }
const { tag, posts } = Astro.props;
const signalLabel = posts.length === 1 ? "signal" : "signals";
---

<PageLayout
  title={`Posts tagged ${tag}`}
  description={`${posts.length} ${signalLabel} tagged ${tag}.`}
  eyebrow="TAGGED TRANSMISSIONS"
  robots={posts.length === 1 ? "noindex,follow" : undefined}
>
  <PostList posts={posts} numbered />
</PageLayout>
