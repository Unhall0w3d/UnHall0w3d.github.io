---
import Badge from "../components/Badge.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const experiments = [
  {
    index: "EXP // 01",
    slug: "observatory",
    name: "Local LLM Observatory",
    brief:
      "Replay a simulated inference-to-render handoff from a 9B local language model to the Rapid renderer across dual GPUs. Scrub the phase timeline to inspect VRAM residency, worker handoffs, and token latency.",
    tags: ["Canvas 2D", "Telemetry Replay", "Multi-GPU"],
    visual: "observatory"
  },
  {
    index: "EXP // 02",
    slug: "kestrel-sound",
    name: "Kestrel Sound",
    brief:
      "Transmit acoustic sonar pulses across a charted inlet to locate three submerged bronze bells. Read bathymetric echo rings and align range-return peaks by pointer or keyboard.",
    tags: ["Canvas 2D", "Web Audio", "Sonar Bathymetry"],
    visual: "kestrel"
  },
  {
    index: "EXP // 03",
    slug: "aftertone",
    name: "Aftertone",
    brief:
      "Sweep an illustrated shortwave field receiver from 5.8 to 15.8 MHz to intercept five lost calls that slipped out of the dial plan. Log all five transmissions to unlock the return carrier.",
    tags: ["Canvas 2D", "Web Audio", "Shortwave Receiver"],
    visual: "aftertone"
  },
  {
    index: "EXP // 04",
    slug: "fold-register",
    name: "Fold Register",
    brief:
      "Sculpt a periodic 4 × 12 × 3 sine neural surface in real time by applying rank-one weight edits. Orbit the 3D manifold, compare against the zero-edit origin, and probe cross-section displacement.",
    tags: ["Three.js", "Neural Weights", "3D Manifold"],
    visual: "fold"
  }
] as const;
---

<BaseLayout
  pagefindBody
  mainClass="af-lab-hub"
  title="The Signal Lab — Experiments"
  description="Interactive browser instruments from NOC Thoughts: Local LLM Observatory, Kestrel Sound, Aftertone, and Fold Register."
>
  <header class="af-lab-hero">
    <p class="af-eyebrow"><span>THE SIGNAL LAB</span> // INTERACTIVE INSTRUMENTS</p>
    <h1>Telemetry, acoustics, and local compute studies.</h1>
    <p class="af-lab-hero__deck">
      Self-contained browser instruments built with 2D Canvas, Web Audio synthesis, and deterministic state machines—zero external APIs required.
    </p>
  </header>

  <div class="af-lab-list">
    {experiments.map((exp) => (
      <article class="af-lab-card">
        <div class="af-lab-card__copy">
          <span class="af-lab-card__idx">{exp.index}</span>
          <h2>
            <a href={`/experiments/${exp.slug}.html`}>{exp.name}</a>
          </h2>
          <p class="af-lab-card__brief">{exp.brief}</p>
          <div class="af-lab-card__tags">
            {exp.tags.map((tag) => (
              <Badge variant="neutral" pill>{tag}</Badge>
            ))}
          </div>
          <div class="af-lab-card__cta-wrap">
            <a class="button button-primary" href={`/experiments/${exp.slug}.html`}>
              Launch Instrument →
            </a>
          </div>
        </div>

        <a
          class={`af-lab-card__visual af-lab-card__visual--${exp.visual}`}
          href={`/experiments/${exp.slug}.html`}
          aria-label={`Launch ${exp.name}`}
          tabindex="-1"
        >
          {exp.visual === "observatory" && (
            <svg viewBox="0 0 560 260" width="560" height="260" aria-hidden="true">
              <rect width="560" height="260" fill="#0B0D10" />
              <g stroke="rgba(255,255,255,0.07)" stroke-width="1">
                <line x1="28" y1="48" x2="532" y2="48" />
                <line x1="28" y1="104" x2="532" y2="104" />
                <line x1="28" y1="160" x2="532" y2="160" />
                <line x1="28" y1="216" x2="532" y2="216" />
              </g>
              <text x="28" y="34" fill="#9CA3AF" font-family="JetBrains Mono, monospace" font-size="11">GPU 0 // NAVI 21 · 16 GB VRAM</text>
              <rect x="28" y="58" width="210" height="24" rx="4" fill="rgba(56,198,184,0.22)" stroke="#38C6B8" />
              <text x="38" y="74" fill="#38C6B8" font-family="JetBrains Mono, monospace" font-size="11">9B REASONER · 48.2 tok/s</text>
              <rect x="248" y="58" width="180" height="24" rx="4" fill="rgba(229,164,72,0.2)" stroke="#E5A448" />
              <text x="258" y="74" fill="#E5A448" font-family="JetBrains Mono, monospace" font-size="11">RAPID RENDERER HANDOFF</text>
              <text x="28" y="128" fill="#9CA3AF" font-family="JetBrains Mono, monospace" font-size="11">GPU 1 // GTX 1070 · COMPACTION WORKER</text>
              <rect x="28" y="138" width="320" height="18" rx="3" fill="rgba(96,165,250,0.24)" stroke="#60A5FA" />
              <polyline fill="none" stroke="#38C6B8" stroke-width="2.5" points="28,212 96,204 162,178 238,174 282,192 356,164 438,168 532,158" />
              <circle cx="248" cy="174" r="4.5" fill="#E5A448" />
            </svg>
          )}

          {exp.visual === "kestrel" && (
            <svg viewBox="0 0 560 260" width="560" height="260" aria-hidden="true">
              <rect width="560" height="260" fill="#061217" />
              <g fill="none" stroke="#38C6B8">
                <circle cx="280" cy="130" r="28" stroke-opacity="0.85" stroke-width="1.6" />
                <circle cx="280" cy="130" r="58" stroke-opacity="0.55" stroke-width="1.3" stroke-dasharray="4 4" />
                <circle cx="280" cy="130" r="92" stroke-opacity="0.32" stroke-width="1.1" />
                <circle cx="280" cy="130" r="126" stroke-opacity="0.16" stroke-width="1" />
              </g>
              <line x1="280" y1="130" x2="366" y2="74" stroke="#34D399" stroke-width="2" />
              <polygon points="354,82 360,76 366,82 360,88" fill="#E5A448" />
              <polygon points="198,168 204,162 210,168 204,174" fill="#34D399" />
              <text x="24" y="34" fill="#38C6B8" font-family="JetBrains Mono, monospace" font-size="11">SONAR BATHYMETRY // 245 M RADIUS</text>
              <polyline fill="none" stroke="#E5A448" stroke-width="1.6" points="24,232 140,232 182,228 204,202 224,232 340,232 360,194 380,232 536,232" />
            </svg>
          )}

          {exp.visual === "aftertone" && (
            <svg viewBox="0 0 560 260" width="560" height="260" aria-hidden="true">
              <rect width="560" height="260" fill="#12100E" />
              <text x="28" y="38" fill="#E5A448" font-family="JetBrains Mono, monospace" font-size="11">AT-5 SHORTWAVE RECEIVER // 6.830 MHz LOCKED</text>
              <rect x="28" y="56" width="504" height="118" rx="6" fill="#191613" stroke="rgba(229,164,72,0.28)" />
              <line x1="48" y1="132" x2="512" y2="132" stroke="rgba(236,238,242,0.22)" />
              <g stroke="rgba(236,238,242,0.42)" stroke-width="1.2">
                <line x1="76" y1="104" x2="76" y2="132" />
                <line x1="128" y1="114" x2="128" y2="132" />
                <line x1="180" y1="98" x2="180" y2="132" />
                <line x1="232" y1="114" x2="232" y2="132" />
                <line x1="284" y1="98" x2="284" y2="132" />
                <line x1="336" y1="114" x2="336" y2="132" />
                <line x1="388" y1="98" x2="388" y2="132" />
                <line x1="440" y1="114" x2="440" y2="132" />
                <line x1="492" y1="104" x2="492" y2="132" />
              </g>
              <line x1="180" y1="68" x2="180" y2="162" stroke="#E5A448" stroke-width="2.5" />
              <circle cx="180" cy="74" r="4.5" fill="#E5A448" />
              <text x="48" y="156" fill="#9CA3AF" font-family="JetBrains Mono, monospace" font-size="10">5.8 MHz</text>
              <text x="260" y="156" fill="#9CA3AF" font-family="JetBrains Mono, monospace" font-size="10">10.8 MHz</text>
              <text x="466" y="156" fill="#9CA3AF" font-family="JetBrains Mono, monospace" font-size="10">15.8 MHz</text>
              <text x="28" y="212" fill="#ECEEF2" font-family="JetBrains Mono, monospace" font-size="12">STATION 01 // THE LAST REPEATER · HIGHLAND EXCHANGE</text>
            </svg>
          )}

          {exp.visual === "fold" && (
            <svg viewBox="0 0 560 260" width="560" height="260" aria-hidden="true">
              <rect width="560" height="260" fill="#0F0E16" />
              <text x="28" y="36" fill="#C6B7F6" font-family="JetBrains Mono, monospace" font-size="11">SINE NETWORK // 4 × 12 × 3 WEIGHT MANIFOLD</text>
              <g fill="none" stroke="#C6B7F6" stroke-opacity="0.55" stroke-width="1.3">
                <ellipse cx="280" cy="138" rx="148" ry="62" />
                <ellipse cx="280" cy="138" rx="112" ry="44" stroke="#E5A448" stroke-opacity="0.75" />
                <ellipse cx="280" cy="138" rx="72" ry="28" stroke="#38C6B8" stroke-opacity="0.8" />
                <path d="M132,138 Q206,68 280,138 T428,138" stroke="#ECEEF2" stroke-opacity="0.5" />
                <path d="M168,138 Q224,196 280,138 T392,138" stroke="#E5A448" stroke-opacity="0.65" />
              </g>
            </svg>
          )}
        </a>
      </article>
    ))}
  </div>
</BaseLayout>

<style is:global>
  .af-lab-hero {
    padding-block: clamp(2rem, 4.5vw, 3.5rem) 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .af-lab-hero h1 {
    max-width: 20ch;
    font-size: clamp(2.15rem, 4.4vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .af-lab-hero__deck {
    max-width: var(--measure-prose);
    margin: 1rem 0 0;
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .af-lab-list {
    display: grid;
    gap: 1.25rem;
    padding-block: 2rem 3rem;
  }

  .af-lab-card {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    overflow: hidden;
  }

  .af-lab-card__copy {
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 2.5vw, 1.85rem);
  }

  .af-lab-card__idx {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--accent-signal-ink);
    margin-bottom: 0.45rem;
  }

  .af-lab-card__copy h2 {
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    line-height: 1.15;
    margin-bottom: 0.65rem;
  }

  .af-lab-card__copy h2 a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .af-lab-card__copy h2 a:hover {
    color: var(--accent-signal-ink);
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .af-lab-card__brief {
    margin: 0 0 1rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .af-lab-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .af-lab-card__cta-wrap {
    margin-top: auto;
  }

  .af-lab-card__visual {
    display: flex;
    align-items: center;
    justify-content: center;
    border-left: 1px solid var(--border-subtle);
    background: var(--bg-code);
    overflow: hidden;
  }

  .af-lab-card__visual svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 56rem) {
    .af-lab-card {
      grid-template-columns: 1fr;
    }

    /* Explanation-first reading order: visual stacks below text on mobile */
    .af-lab-card__visual {
      border-left: 0;
      border-top: 1px solid var(--border-subtle);
    }
  }
</style>
