---
import "../styles/experiments.css";
import BaseLayout from "../layouts/BaseLayout.astro";

const experiments = [
  {
    slug: "observatory",
    name: "Local LLM Observatory",
    description: "Replay a simulated handoff from a 9B language model to the Rapid renderer. Follow the worker, GPU memory, and timeline as the run unfolds."
  },
  {
    slug: "kestrel-sound",
    name: "Kestrel Sound",
    description: "Send a sonar pulse across the inlet. Follow the echoes and chart three submerged bronze bells."
  },
  {
    slug: "aftertone",
    name: "Aftertone",
    description: "Tune a shortwave receiver across five lost calls. Each frequency brings a different landscape and a transmission for your field log."
  }
];
---
<BaseLayout mainClass="experiment-index" title="Experiments" description="Explore interactive experiments from NOC Thoughts, including Local LLM Observatory, Kestrel Sound, and Aftertone.">
  <h1 class="experiment-title">Experiments</h1>
  <div class="experiment-entries">
    {experiments.map(({slug, name, description}) => (
      <article class="experiment-entry">
        <a class="experiment-link" href={`/experiments/${slug}.html`}>
          <div class="experiment-copy"><h2>{name}</h2><p>{description}</p></div>
          <div class="experiment-preview">
            <img src={`/assets/images/experiments/${slug}.webp`} alt="" width="850" height="356" />
          </div>
          <span class="experiment-arrow" aria-hidden="true">→</span>
        </a>
      </article>
    ))}
  </div>
</BaseLayout>
