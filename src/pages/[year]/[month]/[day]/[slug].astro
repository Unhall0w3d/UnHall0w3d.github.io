---
import { getCollection, render } from "astro:content";
import PostLayout from "../../../../layouts/PostLayout.astro";
import { postDateParts, postSlug, sortPosts, type Post } from "../../../../lib/posts";

export async function getStaticPaths() {
  const posts = sortPosts((await getCollection("posts", ({ data }) => !data.draft)) as Post[]);

  return posts.map((post) => {
    const date = postDateParts(post);
    const related = posts
      .filter((candidate) => candidate.id !== post.id)
      .map((candidate) => {
        const samePillar = candidate.data.pillar === post.data.pillar ? 2 : 0;
        const sharedTags = candidate.data.tags.filter((tag) => post.data.tags.includes(tag)).length;
        return { post: candidate, score: samePillar + sharedTags };
      })
      .filter(({ score }) => score > 0)
      .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
      .slice(0, 3)
      .map(({ post: candidate }) => candidate);

    return {
      params: { ...date, slug: postSlug(post) },
      props: { post, related }
    };
  });
}

interface Props {
  post: Post;
  related: Post[];
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout {post} {headings} {related}>
  <Content />
</PostLayout>
