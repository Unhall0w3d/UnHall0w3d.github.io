---
import { getCollection } from "astro:content";
import SpecCard from "../components/SpecCard.astro";
import { toolGroups, tools } from "../config/tools";
import BaseLayout from "../layouts/BaseLayout.astro";
import { postUrl } from "../lib/posts";

const publishedPosts = await getCollection("posts", ({ data }) => !data.draft);

const checksumFiles = import.meta.glob<string>(
  "../../public/assets/downloads/*/SHA256SUMS.txt",
  { query: "?raw", import: "default", eager: true }
);

const entries = tools.map((tool) => {
  const post = publishedPosts.find((p) => p.id.replace(/\.mdx?$/, "") === tool.post);
  if (!post) throw new Error(`Tool ${tool.id} requires a published guide: ${tool.post}`);

  let checksumLines: string[] = [];
  if (tool.checksumKey) {
    const matched = Object.entries(checksumFiles).find(([filePath]) =>
      filePath.includes(`/${tool.checksumKey}/SHA256SUMS.txt`)
    )?.[1];
    if (matched) {
      checksumLines = matched
        .trim()
        .split(/\r?\n/)
        .filter(Boolean);
    }
  }

  return {
    ...tool,
    guide: postUrl(post) + (tool.guideSection ? `#${tool.guideSection}` : ""),
    zipHash: tool.zipHash ?? null,
    checksumLines
  };
});
---

<BaseLayout
  downloadPage
  pagefindBody
  mainClass="af-tools-page"
  title="Tools & Downloads"
  description="Practical Cisco UC scripts, read-only audit queries, backup tools, and agent workflow references, with guides and validation limits."
>
  <section class="af-tools-intro">
    <div class="af-tools-intro__copy">
      <p class="af-eyebrow"><span>THE FIELD TOOLBOX</span> // ENGINEERING SPEC CARDS</p>
      <h1>Tools &amp; downloads</h1>
      <p class="af-tools-intro__deck">
        Inspect the safety posture, platform requirements, and validation boundaries before running any procedure in your environment.
      </p>
      <details class="af-attest-box">
        <summary>Verify a downloaded ZIP with GitHub CLI attestation</summary>
        <p>
          Replace <code>package.zip</code> with the downloaded archive name to cryptographically verify release provenance:
        </p>
        <pre><code>gh attestation verify package.zip --repo Unhall0w3d/UnHall0w3d.github.io --signer-workflow Unhall0w3d/UnHall0w3d.github.io/.github/workflows/deploy.yml</code></pre>
      </details>
    </div>

    <nav class="af-tools-jump" aria-label="Tool categories">
      {toolGroups.map((group) => (
        <a href={`#${group.id}`}>
          <span>{group.title}</span>
          <span aria-hidden="true">↘</span>
        </a>
      ))}
    </nav>
  </section>

  {toolGroups.map((group) => (
    <section class="af-tool-section" id={group.id} aria-labelledby={`${group.id}-title`}>
      <header class="af-tool-section__head">
        <h2 id={`${group.id}-title`}>{group.title}</h2>
        <p>{group.description}</p>
      </header>

      <div class="af-tool-stack">
        {entries
          .filter((tool) => tool.group === group.id)
          .map((tool) => (
            <SpecCard
              id={tool.id}
              title={tool.title}
              href={tool.guide}
              version={tool.version}
              postureLabel={tool.postureLabel}
              postureVariant={tool.postureVariant}
              description={tool.description}
            >
              <dl class="af-spec-grid">
                <div>
                  <dt>Requirements</dt>
                  <dd>{tool.requires}</dd>
                </div>
                <div>
                  <dt>Scope &amp; Validation</dt>
                  <dd>{tool.status}</dd>
                </div>
              </dl>

              <Fragment slot="footer">
                <a class="af-spec-guide-btn" href={tool.guide}>
                  Read Guide →
                </a>

                <div class="af-spec-actions">
                  {tool.downloads && (
                    <nav class="af-download-chips" aria-label={`${tool.title} downloads`}>
                      {tool.downloads.map((download) => (
                        <a class="af-dl-chip" href={download.href} download>
                          {download.label} <span aria-hidden="true">↓</span>
                        </a>
                      ))}
                    </nav>
                  )}

                  {(tool.zipHash || tool.checksumLines.length > 0) && (
                    <details class="af-sha-popover">
                      <summary class="af-sha-trigger">SHA-256 ▾</summary>
                      <div class="af-sha-panel">
                        {tool.zipHash && (
                          <div class="af-sha-primary">
                            <div class="af-sha-primary__head">
                              <span>{tool.zipHash.filename}</span>
                              <button
                                type="button"
                                class="af-sha-copy"
                                data-copy-sha={tool.zipHash.sha256}
                              >
                                Copy SHA-256
                              </button>
                            </div>
                            <code>{tool.zipHash.sha256}</code>
                          </div>
                        )}
                        {tool.checksumLines.length > 0 && (
                          <div class="af-sha-manifest">
                            <div class="af-sha-primary__head">
                              <span>SHA256SUMS.txt ({tool.checksumLines.length} entries)</span>
                              <button
                                type="button"
                                class="af-sha-copy"
                                data-copy-sha={tool.checksumLines.join("\n")}
                              >
                                Copy All
                              </button>
                            </div>
                            <pre><code>{tool.checksumLines.join("\n")}</code></pre>
                          </div>
                        )}
                      </div>
                    </details>
                  )}
                </div>
              </Fragment>
            </SpecCard>
          ))}
      </div>
    </section>
  ))}

  <p class="af-tools-note">
    Looking for an earlier utility? Browse the <a href="/posts.html?tools=1">Signal Archive</a> for legacy scripts and field notes.
  </p>
</BaseLayout>

<style is:global>
  .af-tools-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(15rem, 20rem);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    padding-block: clamp(2rem, 4vw, 3rem) 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .af-tools-intro h1 {
    max-width: none;
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
  }

  .af-tools-intro__deck {
    max-width: 60ch;
    margin: 0.9rem 0 1.15rem;
    color: var(--text-secondary);
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .af-attest-box {
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
  }

  .af-attest-box summary {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-primary);
    cursor: pointer;
  }

  .af-attest-box p {
    margin: 0.6rem 0;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .af-attest-box pre {
    margin: 0;
    padding: 0.65rem 0.8rem;
    overflow-x: auto;
    border-radius: var(--radius-sm);
    background: var(--bg-code);
    color: #ECEEF2;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .af-tools-jump {
    display: grid;
    gap: 1px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--border-subtle);
    overflow: hidden;
  }

  .af-tools-jump a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.55rem 0.95rem;
    background: var(--bg-surface);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
  }

  .af-tools-jump a span:last-child {
    color: var(--accent-signal-ink);
    font-family: var(--font-mono);
  }

  .af-tools-jump a:hover {
    background: var(--bg-surface-elevated);
    color: var(--accent-signal-ink);
  }

  .af-tool-section {
    padding-block: 2.25rem 0.5rem;
    scroll-margin-top: 4.5rem;
  }

  .af-tool-section__head {
    margin-bottom: 1rem;
    padding-left: 0.85rem;
    border-left: 2px solid var(--accent-signal);
  }

  .af-tool-section__head h2 {
    font-size: clamp(1.35rem, 2.3vw, 1.75rem);
    margin-bottom: 0.25rem;
  }

  .af-tool-section__head p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .af-tool-stack {
    display: grid;
    gap: 1rem;
  }

  .af-spec-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.5rem;
    margin: 0;
  }

  .af-spec-grid dt {
    margin-bottom: 0.28rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .af-spec-grid dd {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-primary);
  }

  .af-spec-guide-btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.15rem;
    padding: 0 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--accent-signal);
    background: var(--accent-signal);
    color: var(--text-on-signal);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .af-spec-guide-btn:hover {
    filter: brightness(1.06);
  }

  .af-spec-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .af-download-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .af-dl-chip,
  .af-sha-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 2rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--bg-surface);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }

  .af-sha-trigger::-webkit-details-marker {
    display: none;
  }

  .af-dl-chip span {
    color: var(--accent-verified-ink);
  }

  .af-dl-chip:hover,
  .af-sha-trigger:hover {
    border-color: var(--accent-signal);
    color: var(--accent-signal-ink);
  }

  .af-sha-popover {
    position: relative;
  }

  .af-sha-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.45rem);
    z-index: 25;
    width: min(30rem, calc(100vw - 2.5rem));
    padding: 0.85rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    color: var(--text-primary);
    display: grid;
    gap: 0.75rem;
  }

  .af-sha-primary__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  .af-sha-copy {
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--bg-surface-elevated);
    color: var(--accent-signal-ink);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    cursor: pointer;
  }

  .af-sha-primary code,
  .af-sha-manifest pre {
    display: block;
    margin: 0;
    padding: 0.5rem 0.65rem;
    overflow-x: auto;
    border-radius: var(--radius-sm);
    background: var(--bg-code);
    color: #ECEEF2;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.45;
  }

  .af-tools-note {
    margin: 2.5rem 0 3rem;
    padding: 0.8rem 1rem;
    border-left: 2px solid var(--border-strong);
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .af-tools-note a {
    color: var(--accent-signal-ink);
  }

  @media (max-width: 54rem) {
    .af-tools-intro {
      grid-template-columns: 1fr;
    }

    .af-spec-grid {
      grid-template-columns: 1fr;
    }

    .af-sha-panel {
      position: static;
      width: 100%;
      margin-top: 0.5rem;
    }
  }
</style>
