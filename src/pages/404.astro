---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Signal not found"
  description="The requested NOC Thoughts signal could not be located."
  robots="noindex,follow"
>
  <section class="error-page">
    <p class="error-code">404 // LOST SIGNAL</p>
    <h1>Nothing answers on this frequency.</h1>
    <p>The address may be outdated, mistyped, or lost somewhere between the old machinery and the new archive.</p>
    <a class="button button-primary" href="/posts.html">Search the archive</a>
  </section>
</BaseLayout>

<style>
  .error-page { max-width: 38rem; margin-inline: auto; padding-block: clamp(3rem, 9vw, 7rem); }
  .error-page h1 { max-width: 18ch; font-size: clamp(2.3rem, 4.6vw, 4.6rem); line-height: 1.04; text-transform: none; text-wrap: balance; }
</style>
