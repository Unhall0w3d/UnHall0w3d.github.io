---
import { getEntry, render } from "astro:content";
import { authorSchema } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/reference-pages.css";

const page = await getEntry("pages", "about");
if (!page) throw new Error("About page content is missing");
const { Content } = await render(page);
const description = "The engineer, operator, and caffeine-driven human behind NOC Thoughts.";
---

<BaseLayout title={page.data.title} description={description}>
  <div class="reference-page">
    <header class="page-hero" id="about-me">
      <p class="eyebrow">Operator profile</p>
      <h1>{authorSchema.name}</h1>
      <p class="page-deck">{description}</p>
    </header>
    <script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...authorSchema })} />
    <div class="reference-grid operator-profile"><Content /></div>
  </div>
</BaseLayout>
